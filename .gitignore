# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Virtual Environments ──
.Python
env/
venv/
.venv/

# ── Distribution / Packaging ──
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Environment Variables (CRITICAL) ──
.env
.env.local
.env.*.local

# ── Data Storage (don't commit user data) ──
data/raw/*
data/processed/*
data/artifacts/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/artifacts/.gitkeep

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter Notebook checkpoints
.ipynb_checkpoints

.agent/*
.agent