# ── Required ──────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── CORS (set to your frontend URL on Railway) ───────────────────
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# ── Storage paths (Railway persistent volume mounts here) ────────
# DATA_DIR=/app/data  # uncomment if Railway volume is not at default path

# ── Docling (enabled by default — set false to use legacy extractors) ─
DOCLING_ENABLED=true

# ── Frontend (set in frontend/.env for Vite) ─────────────────────
# VITE_API_URL=https://your-backend.railway.app
