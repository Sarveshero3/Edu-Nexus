# Required — Groq API key for LLM routing and answer generation
GROQ_API_KEY=

# Optional — Nvidia API key (if using Nvidia embeddings)
# NVIDIA_API_KEY=

# Optional — Enable Docling for high-quality PDF parsing (default: false)
# DOCLING_ENABLED=false

# Optional — Comma-separated allowed origins for CORS (default: http://localhost:5173)
# ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com
